[Unit]
Description=YurOTS Web (Retro76)
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/yurots-principal/web
Environment=OT_STATUS_SOURCE=docker
Environment=OT_DOCKER_NAME=yurots
Environment=PORT=8080
Environment=WEB_BIND=127.0.0.1
Environment=OT_HOST=127.0.0.1
Environment=OT_PORT=7171
Environment=SERVER_IP=127.0.0.1
Environment=WEB_LOG_FILE=/var/log/retro76/web.log
Environment=WEB_LOG_DIR=/var/log/retro76
Environment=WEB_LOG_STDOUT=1
Environment=WEB_LOG_LEVEL=INFO
# Token del catálogo privado de ítems (12+ caracteres): mejor en web/.items-admin-token, fuera de git.
# Environment=ITEMS_ADMIN_TOKEN=
# Pendiente para el VPS: un usuario propio en vez de root (escritura solo en state/, uploads/ y los datos del OT).
ExecStart=/usr/bin/python3 /root/yurots-principal/web/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
