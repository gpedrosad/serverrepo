[Unit]
Description=YurOTS Web (Retro76)
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/yurots-principal/web
Environment=OT_STATUS_SOURCE=docker
Environment=OT_DOCKER_NAME=yurots
Environment=PORT=8080
Environment=OT_HOST=127.0.0.1
Environment=OT_PORT=7171
Environment=SERVER_IP=retro76.cl
Environment=WEB_LOG_FILE=/var/log/retro76/web.log
Environment=WEB_LOG_DIR=/var/log/retro76
Environment=WEB_LOG_STDOUT=1
Environment=WEB_LOG_LEVEL=INFO
# Environment=ITEMS_ADMIN_TOKEN=cambiar-en-vps
ExecStart=/usr/bin/python3 /root/yurots-principal/web/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
