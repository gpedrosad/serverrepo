---
// Footer de la web: franja de ítems del juego en pixel art, marca con el estado en vivo,
// tres columnas de links y la barra legal.
// El estado lo llena el script de Base.astro (#foot-status). Ver docs/features/17-web-footer.md.
import { dict, localePath } from '../i18n.js';

interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const T = dict(lang);
const F = T.footer;

// Ítems con dibujo en web/assets/wiki/items (server id). Los de la punta se ocultan en pantallas chicas.
const RELICS = [2268, 20113, 2392, 2493, 2472, 2498, 2520, 2495, 2195, 20123, 2432, 2492, 20112, 2154];
const href = (p: string) => (p.startsWith('/wiki') || p === '/items-nuevos' ? p : localePath(lang, p));
const COLS = [
  { title: F.play, links: ['/cuenta', '/cliente', '/premium', '/bugs'].map((p) => [href(p), T.nav[p as keyof typeof T.nav]]) },
  { title: F.community, links: ['/', '/top', '/power', '/pk', '/muertes'].map((p) => [href(p), T.nav[p as keyof typeof T.nav]]) },
  { title: F.guide, links: [['/wiki/novedades', F.news], ['/wiki', T.nav['/wiki']], [href('/items-nuevos'), T.nav['/items-nuevos']],
    [href('/reglas'), T.nav['/reglas']], [href('/info'), T.nav['/info']], [href('/spells'), T.nav['/spells']]] },
];
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="foot-relics" aria-hidden="true">
    {RELICS.map((id) => <img src={`/assets/wiki/items/${id}.png`} alt="" width="32" height="32" loading="lazy">)}
  </div>

  <div class="foot-main">
    <div class="foot-brand">
      <a class="foot-logo" href={localePath(lang, '/')}>
        <img src="/assets/brand/favicon.png" alt="" width="28" height="28">
        <span>Retro76</span>
      </a>
      <p class="foot-tagline">{F.tagline}</p>
      <p class="status foot-status"><span class="dot"></span><span id="foot-status-text">…</span></p>
    </div>

    {COLS.map((c) => (
      <nav class="foot-col" aria-label={c.title}>
        <h2>{c.title}</h2>
        <ul>{c.links.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
      </nav>
    ))}
  </div>

  <div class="foot-legal">
    <p>© {year} Retro76 · {F.legal}</p>
    <a href="#top" class="foot-up">{F.up} ↑</a>
  </div>
</footer>

