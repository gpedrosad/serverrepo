---
import Base from '../../layouts/Base.astro';
import { dict, langOf, langPaths, localePath } from '../../i18n.js';
export function getStaticPaths() { return langPaths(); }
const lang = langOf(Astro.params.lang);
const T = dict(lang);
// Tamaños aproximados de los zips publicados (web/downloads en el VPS). Actualizar si cambian mucho.
const DOWNLOADS = [
  { id: 'win', file: 'Retro76-Windows.zip', os: 'Windows', size: '28 MB', steps: T.client.winSteps },
  { id: 'mac', file: 'Retro76-Mac.zip', os: 'macOS', size: '22 MB', steps: T.client.macSteps },
];
const fill = (html) => html.replace('{account}', localePath(lang, '/cuenta')).replace('{bugs}', localePath(lang, '/bugs'));
---
<Base lang={lang} title={`${T.client.title} — Retro76`} path="/cliente" description={T.client.description}>
  <section>
    <h1 class="title">{T.client.title}</h1>
    <p class="lede">{T.client.lede}</p>
    <p class="notice hidden" id="dl-started" role="status" data-text={T.client.started}>
      <span id="dl-started-text"></span>
      <span class="muted">{T.client.notStarted} <a id="dl-retry" href="#">{T.client.here}</a>.</span>
    </p>
    <p class="notice hidden" id="dl-mobile">{T.client.mobileNote} <a href={localePath(lang, '/cuenta')}>{T.client.createIt}</a>.</p>
  </section>

  <section class="downloads" id="instalar">
    {DOWNLOADS.map((d) => (
      <article class="dl-card" id={`dl-${d.id}`} data-os={d.id} data-file={`/downloads/${d.file}`} data-name={d.os}>
        <header class="dl-head">
          <h2>{d.os}</h2>
          <a class="btn primary" href={`/downloads/${d.file}`} download>{T.client.download} · {d.size}</a>
        </header>
        <ol class="dl-steps">
          {d.steps.map((step) => <li set:html={step} />)}
        </ol>
      </article>
    ))}
    <p class="small muted hidden" id="other-os" data-text={T.client.otherOs}>
      <span id="other-os-text"></span> <a href="#instalar" id="other-os-link">{T.client.seeSteps}</a></p>
  </section>

  <section>
    <h2 class="label">{T.client.faqTitle}</h2>
    <dl class="faq">
      {T.client.faq.map(([q, a]) => (
        <div><dt>{q}</dt><dd class="muted" set:html={fill(a)} /></div>
      ))}
    </dl>
  </section>

  <section>
    <p class="muted">{T.client.noAccount} <a href={localePath(lang, '/cuenta')}>{T.client.createIt}</a>{T.client.free}</p>
  </section>
</Base>

<script>
  import { detectOS } from '../../lib/client.js';

  const params = new URLSearchParams(location.search);
  const wanted = params.get('d');            // ?d=win / ?d=mac: vino de un botón de descarga
  const os = detectOS();
  const first = wanted === 'mac' || wanted === 'win' ? wanted : (os === 'mac' ? 'mac' : 'win');
  const box = document.querySelector('.downloads');
  const card = document.getElementById(`dl-${first}`);
  if (box && card) box.prepend(card);        // el sistema del visitante primero

  // Solo los pasos de su sistema; el otro queda a un clic.
  const other = document.getElementById(`dl-${first === 'mac' ? 'win' : 'mac'}`);
  const swap = document.getElementById('other-os');
  if (card && other && swap) {
    other.classList.add('hidden');
    document.getElementById('other-os-text').textContent = (swap.dataset.text || '').replace('{os}', other.dataset.name);
    swap.classList.remove('hidden');
    document.getElementById('other-os-link').addEventListener('click', () => {
      other.classList.remove('hidden');
      swap.classList.add('hidden');
    });
  }

  if (os === 'mobile') {
    document.getElementById('dl-mobile').classList.remove('hidden');
  } else if (card && (wanted === 'win' || wanted === 'mac')) {
    // Arranca la descarga sola y deja los pasos a la vista.
    const file = card.dataset.file;
    const note = document.getElementById('dl-started');
    document.getElementById('dl-started-text').textContent =
      (note.dataset.text || '').replace('{os}', card.dataset.name);
    document.getElementById('dl-retry').href = file;
    note.classList.remove('hidden');
    card.classList.add('current');
    history.replaceState(null, '', location.pathname + '#instalar');
    setTimeout(() => { location.href = file; }, 400);
  }
</script>
