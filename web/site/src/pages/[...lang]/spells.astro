---
import Base from '../../layouts/Base.astro';
import { dict, langOf, langPaths, localePath } from '../../i18n.js';
export function getStaticPaths() { return langPaths(); }
const lang = langOf(Astro.params.lang);
const T = dict(lang);
---
<Base lang={lang} title={`${T.spells.title} — Retro76`} path="/spells" description={T.spells.description}>
  <section>
    <h1 class="title">{T.spells.title}</h1>
    <p class="lede">{T.spells.lede}</p>
  </section>
  <section id="spells"><p class="empty">{T.loading}</p></section>
</Base>

<script>
  import { getData, esc, t, $ } from '../../lib/client.js';
  getData().then((d) => {
    const sections = d.spells?.sections || [];
    if (!sections.length) { $('spells').innerHTML = `<p class="empty">${esc(t('noSpells'))}</p>`; return; }
    const [cName, cWords, cMana, cMl, cType] = t('spellCols');
    const kinds = t('kinds');
    $('spells').innerHTML = sections.map((sec, i) => `
      <details class="fold"${i === 0 ? ' open' : ''}>
        <summary><strong>${esc(sec.label)}</strong> <span class="faint small">${esc(t('spellsCount', { n: sec.count }))}</span></summary>
        <div class="fold-body table-scroll">
          <table>
            <thead><tr><th>${cName}</th><th>${cWords}</th><th class="n">${cMana}</th><th class="n">${cMl}</th><th class="wide-only">${cType}</th></tr></thead>
            <tbody>${(sec.spells || []).map((s) => `
              <tr><td>${esc(s.name)}</td><td class="mono muted">${esc(s.words)}</td><td class="n key">${s.mana}</td>
              <td class="n">${s.maglv}</td><td class="faint wide-only">${esc(kinds[s.kind] || s.kind)}</td></tr>`).join('')}</tbody>
          </table>
        </div>
      </details>`).join('');
  }).catch(() => { $('spells').innerHTML = `<p class="empty">${esc(t('serverDown'))}</p>`; });
</script>
