---
import Base from '../../layouts/Base.astro';
import { dict, langOf, langPaths, localePath } from '../../i18n.js';
export function getStaticPaths() { return langPaths(); }
const lang = langOf(Astro.params.lang);
const T = dict(lang);
const clientPath = localePath(lang, '/cliente');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Retro76', url: 'https://retro76.cl/', inLanguage: T.htmlLang, description: T.home.ldDescription },
    { '@type': 'VideoGame', name: 'Retro76', url: 'https://retro76.cl/', genre: 'MMORPG',
      gamePlatform: ['Windows', 'macOS'], playMode: 'MultiPlayer', applicationCategory: 'Game', inLanguage: T.htmlLang,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' } },
  ],
};
---
<Base lang={lang} title={T.home.title} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <h1 class="hero-title" id="hero-title">{T.home.heroTitle}</h1>
      <p class="hero-cta"><a class="btn primary big" href={localePath(lang, '/cuenta')}>{T.home.play}</a></p>
      <p class="muted" id="have-account">{T.home.haveAccount} <a id="dl-link" href={clientPath}>{T.home.getClient}</a></p>
      <p class="small muted hidden" id="mobile-note">{T.home.heroMobile}</p>
    </div>
    <figure class="hero-shot">
      <img src="/assets/home/plaza-480.jpg" srcset="/assets/home/plaza-480.jpg 480w, /assets/home/plaza-960.jpg 960w"
           sizes="(max-width: 720px) 100vw, 360px" width="480" height="320" alt={T.home.heroImgAlt} fetchpriority="high" />
    </figure>
  </section>

  <section>
    <h2 class="label">{T.home.connected} <span class="aside" id="online-count"></span></h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>{T.home.thName}</th><th>{T.home.thVoc}</th><th class="n">{T.home.thLevel}</th></tr></thead>
        <tbody id="online"><tr><td colspan="3" class="empty">{T.loading}</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, t, $, detectOS } from '../../lib/client.js';

  // "Ya tengo cuenta": descarga directa del sistema del visitante; en el celular, aviso de que es para PC.
  const os = detectOS();
  if (os === 'mobile') $('mobile-note').classList.remove('hidden');
  else $('dl-link').href += os === 'mac' ? '?d=mac' : '?d=win';

  function render(d) {
    const online = d.online || [];
    $('online-count').textContent = online.length ? `${online.length}` : '';
    $('online').innerHTML = rowsOrEmpty(online, 3, (p) =>
      `<tr><td>${charLink(p.name)}</td><td class="muted">${esc(p.vocation)}</td><td class="n">${p.level}</td></tr>`,
      t('nobodyOnline'));
  }

  async function refresh(force) {
    try { render(await getData(force)); }
    catch { $('online').innerHTML = `<tr><td colspan="3" class="empty">${esc(t('serverDown'))}</td></tr>`; }
  }
  refresh(false);
  setInterval(() => refresh(true), 60000);
</script>
