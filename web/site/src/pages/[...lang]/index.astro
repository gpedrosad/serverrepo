---
import Base from '../../layouts/Base.astro';
import { dict, langOf, langPaths } from '../../i18n.js';
export function getStaticPaths() { return langPaths(); }
const lang = langOf(Astro.params.lang);
const T = dict(lang);
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Retro76', url: 'https://retro76.cl/', inLanguage: T.htmlLang, description: T.home.ldDescription },
    { '@type': 'VideoGame', name: 'Retro76', url: 'https://retro76.cl/', genre: 'MMORPG',
      gamePlatform: ['Windows', 'macOS'], playMode: 'MultiPlayer', applicationCategory: 'Game', inLanguage: T.htmlLang,
      countryOfOrigin: { '@type': 'Country', name: 'Chile' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CLP', availability: 'https://schema.org/InStock' } },
  ],
};
---
<Base lang={lang} title={T.home.title} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section>
    <p class="note">
      <strong>{T.home.noteStrong}</strong> {T.home.noteText}
      <a href="/downloads/Retro76-Windows.zip">Windows</a> · <a href="/downloads/Retro76-Mac.zip">macOS</a>.
    </p>
  </section>

  <section>
    <dl class="figures">
      <div><dt>{T.home.online}</dt><dd id="f-online">—</dd></div>
      <div><dt>{T.home.peak}</dt><dd id="f-peak">—</dd></div>
      <div><dt>{T.home.uptime}</dt><dd id="f-uptime">—</dd></div>
    </dl>
    <p class="faint small" id="updated" style="margin-top:.5rem">{T.loading}</p>
  </section>

  <section>
    <h2 class="label">{T.home.highlights}</h2>
    <div class="table-scroll">
      <table><tbody id="highlights"><tr><td class="empty">{T.loading}</td></tr></tbody></table>
    </div>
  </section>

  <section>
    <h2 class="label">{T.home.connected} <span class="aside" id="online-count"></span></h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>{T.home.thName}</th><th>{T.home.thVoc}</th><th class="n">{T.home.thLevel}</th></tr></thead>
        <tbody id="online"><tr><td colspan="3" class="empty">{T.loading}</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, t, $ } from '../../lib/client.js';

  function render(d) {
    const s = d.server || {};
    const conn = d.connect || {};
    $('f-online').textContent = s.players_online ?? '—';
    $('f-peak').textContent = s.players_peak ?? '—';
    $('f-uptime').textContent = s.uptime_fmt || '—';
    $('updated').textContent = t('updated', { t: d.updated, addr: `${conn.host || 'retro76.cl'}:${conn.port || 7171}` });

    const r = d.rankings || {};
    const death = (d.deaths || [])[0];
    const pk = (d.top_pk_exp || d.top_fraggers || [])[0];
    const rows = [
      [t('hlLevel'), r.level?.[0], (p) => t('levelN', { n: p.level })],
      [t('hlMl'), r.ml?.[0], (p) => `ML ${p.maglevel}`],
      [t('hlClub'), r.club?.[0], (p) => `club ${p.club}`],
      [t('hlAxe'), r.axe?.[0], (p) => `axe ${p.axe}`],
      [t('hlPk'), pk, (p) => (p.exp_fmt ? `${p.exp_fmt} exp` : `${p.frags} PK`)],
    ].filter(([, p]) => p);
    let html = rows.map(([k, p, detail]) =>
      `<tr><td class="muted">${esc(k)}</td><td>${charLink(p.name)}</td><td class="n">${esc(detail(p))}</td></tr>`).join('');
    if (death) {
      const killer = death.killer_is_player ? charLink(death.killer) : esc(death.killer);
      html += `<tr><td class="muted">${esc(t('hlDeath'))}</td><td>${charLink(death.victim)}</td><td style="text-align:right">${t('by', { name: killer })}</td></tr>`;
    }
    $('highlights').innerHTML = html || `<tr><td class="empty">${esc(t('noRanking'))}</td></tr>`;

    const online = d.online || [];
    $('online-count').textContent = online.length ? `${online.length}` : '';
    $('online').innerHTML = rowsOrEmpty(online, 3, (p) =>
      `<tr><td>${charLink(p.name)}</td><td class="muted">${esc(p.vocation)}</td><td class="n">${p.level}</td></tr>`,
      t('nobodyOnline'));
  }

  async function refresh(force) {
    try { render(await getData(force)); }
    catch { $('updated').textContent = t('serverDown'); }
  }
  refresh(false);
  setInterval(() => refresh(true), 60000);
</script>
