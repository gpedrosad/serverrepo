---
import Base from '../../layouts/Base.astro';
import { dict, langOf, langPaths, localePath } from '../../i18n.js';
export function getStaticPaths() { return langPaths(); }
const lang = langOf(Astro.params.lang);
const T = dict(lang);
const A = T.account;
---
<Base lang={lang} title={A.pageTitle} path="/cuenta" description={A.description}>
  <section>
    <h1 class="title">{A.title}</h1>
    <p class="lede">{A.lede}</p>
  </section>
  <section>
    <form id="account-form" class="form" autocomplete="on">
      <div class="honeypot" aria-hidden="true"><input type="text" name="company" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="form_ts">
      <input type="hidden" name="challenge_id">
      <label class="field"><span>{A.number}</span>
        <input type="number" name="account" required min="100000" max="999999" inputmode="numeric"></label>
      <div class="row">
        <label class="field"><span>{A.password}</span>
          <input type="password" name="password" required minlength="3" maxlength="20" pattern="[a-zA-Z0-9]{3,20}" autocomplete="new-password"></label>
        <label class="field"><span>{A.password2}</span>
          <input type="password" name="password2" required minlength="3" maxlength="20" autocomplete="new-password"></label>
      </div>
      <label class="field"><span>{A.name}</span>
        <input type="text" name="name" required minlength="3" maxlength="20" pattern="[a-zA-Z ]{3,20}" autocomplete="username"></label>
      <div class="row">
        <label class="field"><span>{A.sex}</span>
          <select name="sex"><option value="1">{A.male}</option><option value="0">{A.female}</option></select></label>
        <label class="field"><span>{A.voc}</span>
          <select name="voc"><option value="1">Sorcerer</option><option value="2">Druid</option><option value="3">Paladin</option><option value="4">Knight</option></select></label>
      </div>
      <label class="field"><span>{A.captcha} <span id="captcha-q">…</span></span>
        <input type="number" name="captcha" required inputmode="numeric"></label>
      <div class="actions"><button type="submit" class="btn primary" id="submit">{A.submit}</button></div>
      <p id="result" class="result hidden" role="status"></p>
    </form>
  </section>
  <section>
    <p class="muted">{A.after} <a href={localePath(lang, '/cliente')}>{A.afterLink}</a> {A.afterText}</p>
  </section>
</Base>

<script>
  import { loadChallenge, showResult, t, $ } from '../../lib/client.js';
  const form = $('account-form');
  const result = $('result');
  const question = $('captcha-q');
  loadChallenge(form, question);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.password.value !== form.password2.value) {
      showResult(result, false, t('passwordsDiffer'));
      return;
    }
    $('submit').disabled = true;
    try {
      const r = await fetch('/api/create-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          account: parseInt(form.account.value, 10),
          name: form.name.value.trim(),
          password: form.password.value,
          sex: parseInt(form.sex.value, 10),
          voc: parseInt(form.voc.value, 10),
          captcha: form.captcha.value,
          challenge_id: form.challenge_id.value,
          company: form.company.value,
          form_ts: parseFloat(form.form_ts.value),
        }),
      });
      const d = await r.json();
      showResult(result, !!d.ok, d.message || t('error'));
      if (d.ok) form.reset();
    } catch {
      showResult(result, false, t('connError'));
    } finally {
      $('submit').disabled = false;
      loadChallenge(form, question);
    }
  });
</script>
