---
import Base from '../layouts/Base.astro';
---
<Base title="Top — Retro76" path="/top" description="Ranking de Retro76 (Tibia 7.6): nivel, magic level, skills y PK.">
  <section>
    <h1 class="title">Top</h1>
    <p class="lede">Los mejores personajes por nivel, magic level, skills y PK.</p>
  </section>
  <section>
    <div class="filters" id="rank-tabs" role="group" aria-label="Ranking"></div>
    <div class="filters" id="voc-tabs" role="group" aria-label="Vocación"></div>
    <div class="table-scroll">
      <table>
        <thead id="rank-head"></thead>
        <tbody id="rank-body"><tr><td class="empty">Cargando…</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, $ } from '../lib/client.js';

  const RANKS = {
    level: ['Nivel', ['level', 'exp_fmt', 'maglevel', 'vocation_short', 'lastlogin_rel']],
    ml: ['ML', ['maglevel', 'level', 'vocation_short', 'lastlogin_rel']],
    club: ['Club', ['club', 'level', 'vocation_short', 'lastlogin_rel']],
    sword: ['Sword', ['sword', 'level', 'vocation_short', 'lastlogin_rel']],
    axe: ['Axe', ['axe', 'level', 'vocation_short', 'lastlogin_rel']],
    distance: ['Distance', ['distance', 'level', 'vocation_short', 'lastlogin_rel']],
    frags: ['PK', ['frags', 'level', 'vocation_short', 'lastlogin_rel']],
  };
  const COL = { level: 'Nivel', exp_fmt: 'Exp', maglevel: 'ML', lastlogin_rel: 'Último login', vocation_short: 'Voc',
    club: 'Club', sword: 'Sword', axe: 'Axe', distance: 'Dist', frags: 'PK' };
  const TEXT_COLS = new Set(['vocation_short', 'lastlogin_rel']);
  const WIDE = new Set(['vocation_short', 'lastlogin_rel']);
  const state = { rank: 'level', voc: 'all', data: null };

  function buttons(el, items, current, attr) {
    el.innerHTML = items.map(([k, label]) =>
      `<button type="button" data-${attr}="${esc(k)}" aria-pressed="${k === current}">${esc(label)}</button>`).join('');
  }

  function render() {
    const d = state.data;
    if (!d) return;
    buttons($('rank-tabs'), Object.entries(RANKS).map(([k, v]) => [k, v[0]]), state.rank, 'rank');
    buttons($('voc-tabs'), [['all', 'Todas'], ...(d.vocations || []).map((v) => [v, v])], state.voc, 'voc');
    const [, cols] = RANKS[state.rank];
    const cls = (c) => `${TEXT_COLS.has(c) ? 'muted' : 'n'}${c === cols[0] ? ' key' : ''}${WIDE.has(c) ? ' wide-only' : ''}`;
    $('rank-head').innerHTML = `<tr><th>#</th><th>Nombre</th>${cols.map((c) =>
      `<th class="${TEXT_COLS.has(c) ? '' : 'n'}${WIDE.has(c) ? ' wide-only' : ''}">${COL[c]}</th>`).join('')}</tr>`;
    let list = (d.rankings || {})[state.rank] || [];
    if (state.voc !== 'all') list = list.filter((p) => p.vocation === state.voc);
    $('rank-body').innerHTML = rowsOrEmpty(list, cols.length + 2, (p, i) =>
      `<tr><td class="rank">${i + 1}</td><td>${charLink(p.name)}</td>${cols.map((c) =>
        `<td class="${cls(c)}">${esc(p[c] ?? '—')}</td>`).join('')}</tr>`,
      'Nadie en este ranking todavía.');
  }

  document.querySelector('main').addEventListener('click', (e) => {
    const r = e.target.closest('[data-rank]');
    const v = e.target.closest('[data-voc]');
    if (r) state.rank = r.dataset.rank;
    else if (v) state.voc = v.dataset.voc;
    else return;
    render();
  });

  getData().then((d) => { state.data = d; render(); })
    .catch(() => { $('rank-body').innerHTML = '<tr><td class="empty">Sin conexión con el servidor.</td></tr>'; });
</script>
