---
import Base from '../layouts/Base.astro';
---
<Base title="Spells — Retro76" path="/spells" description="Hechizos de Retro76 por vocación: palabras, mana y magic level.">
  <section>
    <h1 class="title">Spells</h1>
    <p class="lede">Hechizos por vocación, de menor a mayor mana. Incluye instantáneos, runas y munición.</p>
  </section>
  <section id="spells"><p class="empty">Cargando…</p></section>
</Base>

<script>
  import { getData, esc, $ } from '../lib/client.js';
  getData().then((d) => {
    const sections = d.spells?.sections || [];
    if (!sections.length) { $('spells').innerHTML = '<p class="empty">No hay datos de hechizos.</p>'; return; }
    $('spells').innerHTML = sections.map((sec, i) => `
      <details class="fold"${i === 0 ? ' open' : ''}>
        <summary><strong>${esc(sec.label)}</strong> <span class="faint small">${sec.count} hechizos</span></summary>
        <div class="fold-body table-scroll">
          <table>
            <thead><tr><th>Nombre</th><th>Palabras</th><th class="n">Mana</th><th class="n">ML</th><th class="wide-only">Tipo</th></tr></thead>
            <tbody>${(sec.spells || []).map((s) => `
              <tr><td>${esc(s.name)}</td><td class="mono muted">${esc(s.words)}</td><td class="n key">${s.mana}</td>
              <td class="n">${s.maglv}</td><td class="faint wide-only">${esc(s.kind)}</td></tr>`).join('')}</tbody>
          </table>
        </div>
      </details>`).join('');
  }).catch(() => { $('spells').innerHTML = '<p class="empty">Sin conexión con el servidor.</p>'; });
</script>
