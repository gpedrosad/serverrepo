---
import Base from '../layouts/Base.astro';
---
<Base title="Muertes — Retro76" path="/muertes" description="Últimas muertes en Retro76 (Tibia 7.6).">
  <section>
    <h1 class="title">Muertes</h1>
    <p class="lede">Las últimas muertes del servidor.</p>
  </section>
  <section>
    <div class="table-scroll">
      <table>
        <thead><tr><th>#</th><th>Víctima</th><th>Asesino</th><th class="n">Nivel</th><th class="wide-only">Cuándo</th></tr></thead>
        <tbody id="deaths"><tr><td colspan="5" class="empty">Cargando…</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, $ } from '../lib/client.js';
  getData().then((d) => {
    $('deaths').innerHTML = rowsOrEmpty(d.deaths, 5, (x) =>
      `<tr><td class="rank">${x.rank}</td><td>${charLink(x.victim)}</td>` +
      `<td class="bad">${x.killer_is_player ? charLink(x.killer) : esc(x.killer)}</td>` +
      `<td class="n">${x.level}</td><td class="faint wide-only">${esc(x.time_rel)}</td></tr>`,
      'No hay muertes registradas.');
  }).catch(() => { $('deaths').innerHTML = '<tr><td colspan="5" class="empty">Sin conexión con el servidor.</td></tr>'; });
</script>
