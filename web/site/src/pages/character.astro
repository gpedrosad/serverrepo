---
// Perfil de personaje. server.py sirve esta página para /character/<nombre>; el nombre se lee
// de la URL y los datos vienen de /api/character/<nombre>.
import Base from '../layouts/Base.astro';
---
<Base title="Personaje — Retro76" path="/character" canonical={false}
  description="Perfil de personaje en Retro76, OT server chileno de Tibia 7.6: nivel, vocación, experiencia y muertes.">
  <section>
    <p class="faint small" id="crumb"><a href="/top">Top</a> /</p>
    <h1 class="title" id="name">…</h1>
    <p class="lede" id="sub">Cargando…</p>
  </section>
  <section id="body" class="hidden">
    <dl class="figures">
      <div><dt>Nivel</dt><dd id="level">—</dd></div>
      <div><dt>Magic level</dt><dd id="ml">—</dd></div>
      <div><dt>Experiencia</dt><dd id="exp">—</dd></div>
    </dl>
  </section>
  <section id="deaths-section" class="hidden">
    <h2 class="label">Muertes <span class="aside" id="death-count"></span></h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>#</th><th>Asesino</th><th class="n">Nivel</th><th class="wide-only">Cuándo</th></tr></thead>
        <tbody id="deaths"></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { esc, charLink, rowsOrEmpty, $ } from '../lib/client.js';

  function nameFromPath() {
    const parts = location.pathname.split('/').filter(Boolean);
    if (parts[0] !== 'character' || !parts[1]) return '';
    try { return decodeURIComponent(parts.slice(1).join('/')).trim(); } catch { return ''; }
  }

  async function load() {
    const name = nameFromPath();
    if (!name) { $('name').textContent = 'Personaje'; $('sub').textContent = 'Nombre inválido.'; return; }
    $('name').textContent = name;
    document.title = `${name} — Retro76`;
    try {
      const r = await fetch(`/api/character/${encodeURIComponent(name)}`, { cache: 'no-store' });
      const d = await r.json();
      if (!r.ok || !d.ok || !d.character) { $('sub').textContent = d.message || 'Personaje no encontrado.'; return; }
      const c = d.character;
      document.title = `${c.name} — ${c.vocation} nivel ${c.level} | Retro76`;
      $('name').textContent = c.name;
      $('sub').textContent = `${c.vocation}${c.guild ? ` · ${c.guild}` : ''} · visto ${c.lastlogin_rel}`;
      $('level').textContent = c.level;
      $('ml').textContent = c.maglevel;
      $('exp').textContent = c.exp_fmt;
      $('body').classList.remove('hidden');
      const deaths = c.deaths || [];
      $('death-count').textContent = String(deaths.length);
      $('deaths').innerHTML = rowsOrEmpty(deaths, 4, (x, i) =>
        `<tr><td class="rank">${i + 1}</td><td class="bad">${x.killer_is_player ? charLink(x.killer) : esc(x.killer)}</td>` +
        `<td class="n">${x.level}</td><td class="faint wide-only">${esc(x.time_rel)}</td></tr>`,
        'Sin muertes registradas.');
      $('deaths-section').classList.remove('hidden');
    } catch {
      $('sub').textContent = 'Sin conexión con el servidor.';
    }
  }
  load();
</script>
