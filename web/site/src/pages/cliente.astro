---
import Base from '../layouts/Base.astro';
const DOWNLOADS = [
  { file: 'Retro76-Windows.zip', os: 'Windows', run: 'Iniciar Cliente.bat' },
  { file: 'Retro76-Mac.zip', os: 'macOS', run: 'Iniciar Cliente.command' },
];
---
<Base title="Cliente — Retro76" path="/cliente" description="Descarga el cliente de Retro76 (Tibia 7.6) para Windows y macOS.">
  <section>
    <h1 class="title">Cliente</h1>
    <p class="lede">El cliente oficial ya trae los items custom. Descarga el ZIP, descomprímelo y abre el lanzador.</p>
  </section>
  <section>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Sistema</th><th>Abrir</th><th></th></tr></thead>
        <tbody>
          {DOWNLOADS.map((d) => (
            <tr>
              <td><strong>{d.os}</strong></td>
              <td class="mono muted">{d.run}</td>
              <td style="text-align:right"><a class="btn primary" href={`/downloads/${d.file}`} download>Descargar ZIP</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section>
    <h2 class="label">Conectarse</h2>
    <p class="muted">El cliente ya viene configurado. Si te lo piden: <span class="mono" id="addr">retro76.cl:7171</span>.</p>
    <p class="muted">¿No tienes cuenta? <a href="/cuenta">Créala acá</a>, es gratis.</p>
  </section>
</Base>

<script>
  import { getData } from '../lib/client.js';
  getData().then((d) => {
    const c = d.connect || {};
    if (c.host && c.port) document.getElementById('addr').textContent = `${c.host}:${c.port}`;
  }).catch(() => {});
</script>
