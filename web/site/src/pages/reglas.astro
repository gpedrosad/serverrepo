---
import Base from '../layouts/Base.astro';
---
<Base title="Reglas — Retro76" path="/reglas" description="Reglas de Retro76.">
  <section>
    <h1 class="title">Reglas</h1>
    <p class="lede">Reglas cortas. El staff revisa logs y reportes; la sanción depende de cada caso.</p>
  </section>
  <section id="rules"><p class="empty">Cargando…</p></section>
</Base>

<script>
  import { getData, esc, $ } from '../lib/client.js';
  // Cada línea de OTINFO REGLAS viene como "Categoría · texto".
  getData().then((d) => {
    const rules = (d.otinfo || []).find((s) => s.title === 'REGLAS');
    if (!rules) { $('rules').innerHTML = '<p class="empty">Sin reglas publicadas.</p>'; return; }
    const groups = new Map();
    for (const line of rules.lines) {
      const i = line.indexOf(' · ');
      const cat = i >= 0 ? line.slice(0, i) : 'General';
      if (!groups.has(cat)) groups.set(cat, []);
      groups.get(cat).push(i >= 0 ? line.slice(i + 3) : line);
    }
    $('rules').innerHTML = [...groups].map(([cat, items]) => `
      <h2 class="label">${esc(cat)}</h2>
      <ol class="numbered" style="margin-bottom:1.75rem">${items.map((t) => `<li>${esc(t)}</li>`).join('')}</ol>`).join('');
  }).catch(() => { $('rules').innerHTML = '<p class="empty">Sin conexión con el servidor.</p>'; });
</script>
