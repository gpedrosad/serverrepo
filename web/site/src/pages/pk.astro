---
import Base from '../layouts/Base.astro';
---
<Base title="PK — Retro76" path="/pk" description="Jugadores que más matan en Retro76: PK de hoy y experiencia ganada por matar.">
  <section>
    <h1 class="title">PK</h1>
    <p class="lede">Quién mata más jugadores y cuánta experiencia sacó de eso.</p>
  </section>
  <section id="today-section" class="hidden">
    <h2 class="label">PK de hoy</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>#</th><th>Nombre</th><th class="n">PK</th><th class="n">Nivel</th></tr></thead>
        <tbody id="today"></tbody>
      </table>
    </div>
  </section>
  <section>
    <h2 class="label">Experiencia por matar jugadores
      <span class="aside filters" id="sort" role="group" aria-label="Ordenar">
        <button type="button" data-sort="exp" aria-pressed="true">por exp</button>
        <button type="button" data-sort="kills" aria-pressed="false">por PK</button>
      </span>
    </h2>
    <p class="faint small">Estimado desde el registro de muertes: 7% de la exp de la víctima × 80%.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>#</th><th>Nombre</th><th class="n">Exp PK</th><th class="n">PK</th><th class="n">Nivel</th><th class="wide-only">Voc</th></tr></thead>
        <tbody id="pk"><tr><td colspan="6" class="empty">Cargando…</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, $ } from '../lib/client.js';
  let data = null;
  let sort = 'exp';

  function render() {
    const today = data.frags_today || [];
    $('today-section').classList.toggle('hidden', !today.length);
    $('today').innerHTML = today.map((p, i) =>
      `<tr><td class="rank">${i + 1}</td><td>${charLink(p.name)}</td><td class="n key">${p.frags}</td><td class="n">${p.level}</td></tr>`).join('');
    const list = [...(data.top_pk_exp || [])].sort(sort === 'kills'
      ? (a, b) => (b.kills - a.kills) || (b.exp - a.exp)
      : (a, b) => (b.exp - a.exp) || (b.kills - a.kills));
    $('pk').innerHTML = rowsOrEmpty(list, 6, (p, i) =>
      `<tr><td class="rank">${i + 1}</td><td>${charLink(p.name)}</td>` +
      `<td class="n${sort === 'exp' ? ' key' : ''}">${esc(p.exp_fmt)}</td><td class="n${sort === 'kills' ? ' key' : ''}">${p.kills}</td>` +
      `<td class="n">${p.level}</td><td class="muted wide-only">${esc(p.vocation_short)}</td></tr>`,
      'No hay kills entre jugadores en el registro.');
    document.querySelectorAll('#sort button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === sort)));
  }

  $('sort').addEventListener('click', (e) => {
    const b = e.target.closest('[data-sort]');
    if (!b || !data) return;
    sort = b.dataset.sort;
    render();
  });
  getData().then((d) => { data = d; render(); })
    .catch(() => { $('pk').innerHTML = '<tr><td colspan="6" class="empty">Sin conexión con el servidor.</td></tr>'; });
</script>
