---
import Base from '../layouts/Base.astro';
---
<Base title="Crear cuenta — Retro76" path="/cuenta" description="Crea tu cuenta gratis en Retro76, OT server chileno de Tibia 7.6.">
  <section>
    <h1 class="title">Crear cuenta</h1>
    <p class="lede">Gratis. La cuenta es un número de 6 dígitos y con ella entras al juego con tu personaje.</p>
  </section>
  <section>
    <form id="account-form" class="form" autocomplete="on">
      <div class="honeypot" aria-hidden="true"><input type="text" name="company" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="form_ts">
      <input type="hidden" name="challenge_id">
      <label class="field"><span>Número de cuenta (6 dígitos)</span>
        <input type="number" name="account" required min="100000" max="999999" inputmode="numeric"></label>
      <div class="row">
        <label class="field"><span>Contraseña</span>
          <input type="password" name="password" required minlength="3" maxlength="20" pattern="[a-zA-Z0-9]{3,20}" autocomplete="new-password"></label>
        <label class="field"><span>Repetir contraseña</span>
          <input type="password" name="password2" required minlength="3" maxlength="20" autocomplete="new-password"></label>
      </div>
      <label class="field"><span>Nombre del personaje</span>
        <input type="text" name="name" required minlength="3" maxlength="20" pattern="[a-zA-Z ]{3,20}" autocomplete="username"></label>
      <div class="row">
        <label class="field"><span>Sexo</span>
          <select name="sex"><option value="1">Masculino</option><option value="0">Femenino</option></select></label>
        <label class="field"><span>Vocación</span>
          <select name="voc"><option value="1">Sorcerer</option><option value="2">Druid</option><option value="3">Paladin</option><option value="4">Knight</option></select></label>
      </div>
      <label class="field"><span>Verificación: <span id="captcha-q">…</span></span>
        <input type="number" name="captcha" required inputmode="numeric"></label>
      <div class="actions"><button type="submit" class="btn primary" id="submit">Crear cuenta</button></div>
      <p id="result" class="result hidden" role="status"></p>
    </form>
  </section>
  <section>
    <p class="muted">Después <a href="/cliente">descarga el cliente</a> y entra con tu número de cuenta y contraseña.</p>
  </section>
</Base>

<script>
  import { loadChallenge, showResult, $ } from '../lib/client.js';
  const form = $('account-form');
  const result = $('result');
  const question = $('captcha-q');
  loadChallenge(form, question);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.password.value !== form.password2.value) {
      showResult(result, false, 'Las contraseñas no coinciden.');
      return;
    }
    $('submit').disabled = true;
    try {
      const r = await fetch('/api/create-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          account: parseInt(form.account.value, 10),
          name: form.name.value.trim(),
          password: form.password.value,
          sex: parseInt(form.sex.value, 10),
          voc: parseInt(form.voc.value, 10),
          captcha: form.captcha.value,
          challenge_id: form.challenge_id.value,
          company: form.company.value,
          form_ts: parseFloat(form.form_ts.value),
        }),
      });
      const d = await r.json();
      showResult(result, !!d.ok, d.message || 'Error');
      if (d.ok) form.reset();
    } catch {
      showResult(result, false, 'Error de conexión.');
    } finally {
      $('submit').disabled = false;
      loadChallenge(form, question);
    }
  });
</script>
