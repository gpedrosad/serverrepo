---
import Base from '../layouts/Base.astro';
---
<Base title="Info — Retro76" path="/info" description="Información del servidor Retro76: rates, sistemas y datos para conectarse.">
  <section>
    <h1 class="title">Info</h1>
    <p class="lede">Rates, sistemas del servidor y cómo conectarse.</p>
  </section>
  <section id="info"><p class="empty">Cargando…</p></section>
</Base>

<script>
  import { getData, esc, $ } from '../lib/client.js';
  getData().then((d) => {
    const sections = (d.otinfo || []).filter((s) => s.title !== 'REGLAS' && s.title !== 'PREMIUM');
    if (!sections.length) { $('info').innerHTML = '<p class="empty">Sin información publicada.</p>'; return; }
    $('info').innerHTML = sections.map((s) => `
      <h2 class="label">${esc(s.title)}</h2>
      <ul style="list-style:none;margin-bottom:1.75rem">${s.lines.map((l) => `<li class="muted" style="padding:.2rem 0">${esc(l)}</li>`).join('')}</ul>`).join('');
  }).catch(() => { $('info').innerHTML = '<p class="empty">Sin conexión con el servidor.</p>'; });
</script>
