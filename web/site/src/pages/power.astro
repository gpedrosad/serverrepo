---
import Base from '../layouts/Base.astro';
---
<Base title="Power — Retro76" path="/power" description="Quién ganó más experiencia hoy en Retro76.">
  <section>
    <h1 class="title">Power</h1>
    <p class="lede">Experiencia ganada hoy.</p>
  </section>
  <section>
    <div class="table-scroll">
      <table>
        <thead><tr><th>#</th><th>Nombre</th><th class="n">Exp hoy</th><th class="n">Nivel</th><th class="wide-only">Voc</th></tr></thead>
        <tbody id="power"><tr><td colspan="5" class="empty">Cargando…</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, $ } from '../lib/client.js';
  getData().then((d) => {
    $('power').innerHTML = rowsOrEmpty(d.powergamers, 5, (p, i) =>
      `<tr><td class="rank">${i + 1}</td><td>${charLink(p.name)}</td><td class="n key">${esc(p.gain_fmt)}</td>` +
      `<td class="n">${p.level}</td><td class="muted wide-only">${esc(p.vocation_short)}</td></tr>`,
      'Nadie ganó experiencia hoy todavía.');
  }).catch(() => { $('power').innerHTML = '<tr><td colspan="5" class="empty">Sin conexión con el servidor.</td></tr>'; });
</script>
