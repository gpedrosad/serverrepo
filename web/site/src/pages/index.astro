---
import Base from '../layouts/Base.astro';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Retro76', url: 'https://retro76.cl/', inLanguage: 'es-CL',
      description: 'OT server chileno de Tibia 7.6 (Open Tibia): rankings, registro de cuentas y descarga del cliente.' },
    { '@type': 'VideoGame', name: 'Retro76', url: 'https://retro76.cl/', genre: 'MMORPG',
      gamePlatform: ['Windows', 'macOS'], playMode: 'MultiPlayer', applicationCategory: 'Game', inLanguage: 'es-CL',
      countryOfOrigin: { '@type': 'Country', name: 'Chile' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CLP', availability: 'https://schema.org/InStock' } },
  ],
};
---
<Base title="Retro76 — OT Server Chileno Tibia 7.6 | Open Tibia Chile" path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section>
    <p class="note">
      <strong>Cliente nuevo (julio 2026)</strong> con los items custom incluidos. Descarga el ZIP, descomprime y abre el lanzador:
      <a href="/downloads/Retro76-Windows.zip">Windows</a> · <a href="/downloads/Retro76-Mac.zip">macOS</a>.
    </p>
  </section>

  <section>
    <dl class="figures">
      <div><dt>Jugando ahora</dt><dd id="f-online">—</dd></div>
      <div><dt>Récord</dt><dd id="f-peak">—</dd></div>
      <div><dt>Uptime</dt><dd id="f-uptime">—</dd></div>
    </dl>
    <p class="faint small" id="updated" style="margin-top:.5rem">Cargando…</p>
  </section>

  <section>
    <h2 class="label">Destacados</h2>
    <div class="table-scroll">
      <table>
        <tbody id="highlights"><tr><td class="empty">Cargando…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section>
    <h2 class="label">Conectados <span class="aside" id="online-count"></span></h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Nombre</th><th>Vocación</th><th class="n">Nivel</th></tr></thead>
        <tbody id="online"><tr><td colspan="3" class="empty">Cargando…</td></tr></tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { getData, esc, charLink, rowsOrEmpty, $ } from '../lib/client.js';

  function render(d) {
    const s = d.server || {};
    const conn = d.connect || {};
    $('f-online').textContent = s.players_online ?? '—';
    $('f-peak').textContent = s.players_peak ?? '—';
    $('f-uptime').textContent = s.uptime_fmt || '—';
    $('updated').textContent = `Actualizado ${d.updated} · ${conn.host || 'retro76.cl'}:${conn.port || 7171} · se renueva cada minuto`;

    const r = d.rankings || {};
    const death = (d.deaths || [])[0];
    const pk = (d.top_pk_exp || d.top_fraggers || [])[0];
    const rows = [
      ['Nivel más alto', r.level?.[0], (p) => `nivel ${p.level}`],
      ['Magic level', r.ml?.[0], (p) => `ML ${p.maglevel}`],
      ['Club', r.club?.[0], (p) => `club ${p.club}`],
      ['Axe', r.axe?.[0], (p) => `axe ${p.axe}`],
      ['Más exp por PK', pk, (p) => (p.exp_fmt ? `${p.exp_fmt} exp` : `${p.frags} PK`)],
    ].filter(([, p]) => p);
    let html = rows.map(([k, p, detail]) =>
      `<tr><td class="muted">${k}</td><td>${charLink(p.name)}</td><td class="n">${esc(detail(p))}</td></tr>`).join('');
    if (death) {
      const killer = death.killer_is_player ? charLink(death.killer) : esc(death.killer);
      html += `<tr><td class="muted">Última muerte</td><td>${charLink(death.victim)}</td><td style="text-align:right">por ${killer}</td></tr>`;
    }
    $('highlights').innerHTML = html || '<tr><td class="empty">Todavía no hay jugadores en el ranking.</td></tr>';

    const online = d.online || [];
    $('online-count').textContent = online.length ? `${online.length}` : '';
    $('online').innerHTML = rowsOrEmpty(online, 3, (p) =>
      `<tr><td>${charLink(p.name)}</td><td class="muted">${esc(p.vocation)}</td><td class="n">${p.level}</td></tr>`,
      'Nadie conectado en este momento.');
  }

  async function refresh(force) {
    try { render(await getData(force)); }
    catch { $('updated').textContent = 'Sin conexión con el servidor.'; }
  }
  refresh(false);
  setInterval(() => refresh(true), 60000);
</script>
