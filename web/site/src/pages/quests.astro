---
import Base from '../layouts/Base.astro';
import data from '../data/quests.json';
import questRoutesData from '../data/quest_routes.json';

type QuestRoute = { note: string; steps: string[]; images: { src: string; caption: string }[] };
const questRoutes = questRoutesData as Record<string, QuestRoute>;

const typeLabel = Object.fromEntries(data.groups.map((g) => [g.key, g.label]));
const quests = [...data.quests].sort((a, b) => a.level_min - b.level_min || a.name.localeCompare(b.name));
const proposals = [...data.proposals].sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));
const mapChests = [...(data.map_chests || [])].sort((a, b) => a.level_min - b.level_min || a.quest.localeCompare(b.quest) || a.x - b.x || a.y - b.y);
const pendingItems = data.pending_items || [];
const totalChests = quests.reduce((n, q) => n + (q.chests || 0), 0);
const chestQuests = quests.filter((q) => q.type === 'cofre' || q.type === 'grupo').length;
const systemQuests = quests.length - chestQuests;
const typeCounts = Object.fromEntries(data.groups.map((g) => [g.key, quests.filter((q) => q.type === g.key).length]));
const searchText = (q: (typeof quests)[number]) => `${q.name} ${q.where} ${q.reward} ${q.note} ${typeLabel[q.type] || ''}`.toLowerCase();
const icons = (ids: number[]) => ids.filter((id) => id > 0);
---

<style is:global>
.quest-row { cursor: pointer; }
.quest-route-toggle {
  font: 600 12px/1 var(--sans);
  padding: .35rem .5rem;
  border: 1px solid var(--rule-strong);
  border-radius: 3px;
  background: transparent;
  color: var(--accent);
  cursor: pointer;
  white-space: nowrap;
}
.quest-route-toggle:hover { border-color: var(--accent); }
.quest-route-row > td { padding: 0; background: var(--bg-raise); }
.quest-route { padding: 1rem; border-left: 2px solid var(--accent); }
.quest-route-steps { margin: .5rem 0 0; padding-left: 1.25rem; color: var(--muted); }
.quest-route-images {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: .75rem;
  margin-top: .9rem;
}
.quest-route-images figure { margin: 0; }
.quest-route-images img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--rule);
  border-radius: 3px;
}
.quest-route-images figcaption { font-size: 12px; color: var(--faint); margin-top: .25rem; }
</style>

<Base lang="es" title="Quests — Retro76" path="/quests" description="Registro de todas las quests de Retro76: nivel recomendado, ubicación, recompensa con sus ítems y las quests que recomendamos crear." langSwitch={false}>
  <section>
    <h1 class="title">Quests</h1>
    <p class="lede">Todas las quests y sistemas con recompensa del servidor: nivel recomendado, dónde se empiezan, qué items dan y qué falta. Al final, una lista de quests nuevas que recomendamos crear.</p>
    <dl class="figures">
      <div><dt>Existentes</dt><dd>{quests.length}</dd></div>
      <div><dt>Cofres de quest</dt><dd>{totalChests}</dd></div>
      <div><dt>Propuestas</dt><dd>{proposals.length}</dd></div>
    </dl>
    <p class="note" style="margin-top:1rem">Los niveles son <strong>recomendados</strong>, no requisitos. Las únicas exigencias reales son las puertas de <strong>Hell Quest</strong> (nivel 80 y 100) y la <strong>Arena PvP</strong> (nivel 25).</p>
    <p class="muted small" style="margin-top:.6rem">{chestQuests} quests con cofre/grupo · {systemQuests} sistemas repetibles · {pendingItems.length} items sin drop de monstruo · <a href="#cofres">ver los {mapChests.length} cofres uno por uno</a>. Los niveles de las quests clásicas son estimados según los monstruos de la zona y la recompensa.</p>
  </section>

  <section>
    <h2 class="label">Quests existentes <span class="aside">{quests.length} en total</span></h2>
    <div class="filters" id="quest-filters" role="group" aria-label="Filtrar por tipo">
      <button type="button" data-type="todos" aria-pressed="true">Todas <span class="faint">{quests.length}</span></button>
      {data.groups.map((g) => (
        <button type="button" data-type={g.key} aria-pressed="false">{g.label} <span class="faint">{typeCounts[g.key]}</span></button>
      ))}
    </div>
    <div class="field" style="max-width:24rem;margin:.75rem 0">
      <input type="search" id="quest-search" placeholder="Buscar quest, recompensa o zona…" autocomplete="off" aria-label="Buscar quest">
    </div>
    <div class="table-scroll">
      <table class="quests-table" id="quests-table">
        <thead>
          <tr>
            <th>Quest</th>
            <th>Tipo</th>
            <th class="n">Nivel</th>
            <th>Dónde</th>
            <th>Recompensa</th>
            <th class="wide-only">Notas</th>
            <th>Ruta</th>
          </tr>
        </thead>
        <tbody>
          {quests.map((q) => {
            const route = questRoutes[q.id];
            return (
              <>
                <tr data-type={q.type} data-name={searchText(q)} data-quest={q.id} class="quest-row">
                  <td><strong>{q.name}</strong></td>
                  <td><span class={`quest-type ${q.type}`}>{typeLabel[q.type] || q.type}</span></td>
                  <td class="n"><strong>{q.level_label}</strong><span class="quest-players">{q.players} jug.</span></td>
                  <td class="muted">{q.where}</td>
                  <td class="reward">
                    {icons(q.reward_ids || []).length > 0 && (
                      <span class="reward-icons">
                        {icons(q.reward_ids || []).map((id) => <img src={`/assets/wiki/items/${id}.png`} alt="" width="24" height="24" loading="lazy" />)}
                      </span>
                    )}
                    {q.reward}
                  </td>
                  <td class="muted wide-only">{q.note}</td>
                  <td><button type="button" class="quest-route-toggle" data-quest={q.id} aria-expanded="false">Cómo llegar</button></td>
                </tr>
                {route && (
                  <tr class="quest-route-row" id={`route-${q.id}`} hidden>
                    <td colspan="7">
                      <div class="quest-route">
                        <p class="muted">{route.note}</p>
                        <ol class="quest-route-steps">
                          {route.steps.map((step) => <li>{step}</li>)}
                        </ol>
                        <div class="quest-route-images">
                          {route.images.map((img) => (
                            <figure>
                              <img src={img.src} alt={img.caption} loading="lazy" />
                              <figcaption>{img.caption}</figcaption>
                            </figure>
                          ))}
                        </div>
                      </div>
                    </td>
                  </tr>
                )}
              </>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="empty hidden" id="quests-empty">Ninguna quest coincide con el filtro.</p>
  </section>

  <section id="cofres">
    <h2 class="label">Todos los cofres del mapa <span class="aside">{mapChests.length} cofres</span></h2>
    <p class="muted">Cada cofre con su coordenada exacta, el ítem que entrega y la quest a la que pertenece. Son 40 cofres: 29 de <code>quest.lua</code>, 4 del Annihilator, 3 del Pharaoh y 4 del Hell Quest.</p>
    <div class="field" style="max-width:24rem;margin:.75rem 0">
      <input type="search" id="chest-search" placeholder="Buscar cofre, quest, premio o coordenada…" autocomplete="off" aria-label="Buscar cofre">
    </div>
    <div class="table-scroll">
      <table class="quests-table chests-table" id="chests-table">
        <thead>
          <tr>
            <th>Quest</th>
            <th>Coordenadas</th>
            <th>Premio</th>
            <th class="n">Nivel</th>
            <th>Lugar</th>
          </tr>
        </thead>
        <tbody>
          {mapChests.map((c) => (
            <tr data-name={`${c.quest} ${c.reward} ${c.place} ${c.x} ${c.y} ${c.z} ${c.uid}`.toLowerCase()}>
              <td><strong>{c.quest}</strong><span class="quest-where">UID {c.uid}</span></td>
              <td class="mono">{c.x}, {c.y}, {c.z}</td>
              <td class="reward"><span class="reward-icons"><img src={`/assets/wiki/items/${c.reward_id}.png`} alt="" width="24" height="24" loading="lazy" /></span>{c.reward}</td>
              <td class="n"><strong>{c.level}</strong></td>
              <td class="muted">{c.place}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty hidden" id="chests-empty">Ningún cofre coincide con el filtro.</p>
  </section>

  <section>
    <h2 class="label">Recomendadas para crear <span class="aside">{proposals.length} propuestas</span></h2>
    <p class="muted">Ideas para cubrir huecos de nivel y reusar contenido que ya existe. Son propuestas, no están en el juego.</p>
    <div class="table-scroll">
      <table class="quests-table proposals-table">
        <thead>
          <tr>
            <th>Quest</th>
            <th class="n">Nivel</th>
            <th>Jugadores</th>
            <th>Recompensa</th>
            <th>Por qué</th>
          </tr>
        </thead>
        <tbody>
          {proposals.map((q) => (
            <tr>
              <td><strong>{q.name}</strong><span class="proposal-tag">Propuesta</span><span class="quest-where">{q.where}</span></td>
              <td class="n"><strong>{q.level_label}</strong></td>
              <td class="muted">{q.players}</td>
              <td class="reward">
                {icons(q.reward_ids || []).length > 0 && (
                  <span class="reward-icons">
                    {icons(q.reward_ids || []).map((id) => <img src={`/assets/wiki/items/${id}.png`} alt="" width="24" height="24" loading="lazy" />)}
                  </span>
                )}
                {q.reward}
              </td>
              <td class="why">{q.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="sin-fuente">
    <h2 class="label">Items sin drop de monstruo <span class="aside">{pendingItems.length} pendientes</span></h2>
    <p class="muted">Estos items no salen de ningún monstruo. Los que ya tienen una quest están en la tabla de arriba; estos todavía no tienen una fuente clara, así que necesitan una quest o un sistema que los entregue.</p>
    <div class="table-scroll">
      <table class="quests-table">
        <thead>
          <tr>
            <th>Item</th>
            <th>Fuente actual</th>
            <th>Quest propuesta</th>
            <th class="n">Nivel</th>
            <th class="wide-only">Nota</th>
          </tr>
        </thead>
        <tbody>
          {pendingItems.map((it) => (
            <tr>
              <td><span class="cell-item"><img class="sprite" src={`/assets/wiki/items/${it.id}.png`} alt="" width="32" height="32" loading="lazy" /><strong>{it.name}</strong></span></td>
              <td class="muted">{it.source}</td>
              <td>{it.quest}</td>
              <td class="n"><strong>{it.level}</strong></td>
              <td class="muted wide-only">{it.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small" style="margin-top:.6rem">No se listan los objetos de sistema que se entregan por tienda o premium (runas consumibles, trainer dummy, scrolls, accesorios dorados) ni los que ya tienen cofre/quest.</p>
  </section>

  <section>
    <h2 class="label">Guías relacionadas</h2>
    <p class="muted">
      <a href="/wiki/hell-quest">Hell Quest</a> · <a href="/wiki/castillo-imperial">Castillo Imperial</a> ·
      <a href="/wiki/desierto-de-las-ruinas">Desierto de las Ruinas</a> · <a href="/wiki/isla-del-hielo-eterno">Isla del Hielo</a> ·
      <a href="/wiki/wave-arena">Wave Arena</a> · <a href="/wiki/reloj-de-arena">Reloj de Arena</a> ·
      <a href="/wiki/el-crisol">El Crisol</a> · <a href="/wiki/tarea-diaria">Daily Task</a>
    </p>
  </section>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#quest-filters button')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#quests-table tbody tr[data-quest]')];
  const search = document.getElementById('quest-search') as HTMLInputElement;
  const empty = document.getElementById('quests-empty') as HTMLParagraphElement;
  let type = 'todos';

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const row of rows) {
      const ok = (type === 'todos' || row.dataset.type === type) && (!q || (row.dataset.name || '').includes(q));
      row.hidden = !ok;
      const route = document.getElementById(`route-${row.dataset.quest}`);
      if (route) route.hidden = true;
      if (ok) shown++;
    }
    empty.classList.toggle('hidden', shown > 0);
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      type = button.dataset.type || 'todos';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
      apply();
    });
  }
  search.addEventListener('input', apply);

  const setQuestRoute = (id: string, open: boolean) => {
    const row = document.getElementById(`route-${id}`);
    const btn = document.querySelector<HTMLButtonElement>(`.quest-route-toggle[data-quest="${id}"]`);
    if (!row) return;
    row.hidden = !open;
    if (btn) {
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Ocultar ruta' : 'Cómo llegar';
    }
  };
  const toggleQuestRoute = (id: string) => {
    const row = document.getElementById(`route-${id}`);
    if (row) setQuestRoute(id, row.hidden);
  };
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.quest-route-toggle')) {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      if (btn.dataset.quest) toggleQuestRoute(btn.dataset.quest);
    });
  }
  for (const row of rows) {
    row.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a,button')) return;
      if (row.dataset.quest) toggleQuestRoute(row.dataset.quest);
    });
  }

  const chestRows = [...document.querySelectorAll<HTMLTableRowElement>('#chests-table tbody tr')];
  const chestSearch = document.getElementById('chest-search') as HTMLInputElement;
  const chestEmpty = document.getElementById('chests-empty') as HTMLParagraphElement;
  chestSearch.addEventListener('input', () => {
    const q = chestSearch.value.trim().toLowerCase();
    let shown = 0;
    for (const row of chestRows) {
      const ok = !q || (row.dataset.name || '').includes(q);
      row.hidden = !ok;
      if (ok) shown++;
    }
    chestEmpty.classList.toggle('hidden', shown > 0);
  });
</script>
