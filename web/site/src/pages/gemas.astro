---
import Base from '../layouts/Base.astro';
// Quién suelta cada gema: se arma al compilar desde web/data/gem-drops.json (sin JS para mostrarlo).
import drops from '../../../data/gem-drops.json';

const img = (id: number, large = false) => {
  const base = `/assets/gems/${id}-${large ? 'large' : 'small'}`;
  return { src: `${base}.jpg`, srcset: `${base}@2x.jpg 2x`, size: large ? 40 : 32 };
};

const SMALL = [
  [2150, 'Amethyst'], [2149, 'Emerald'], [2147, 'Ruby'], [2146, 'Sapphire'], [2145, 'Diamond'],
] as const;

const EXCHANGE = [
  { small: 2147, big: 2156, smallName: 'Ruby', bigName: 'Big Ruby', bonus: '+5% / +9% / +16% velocidad de ataque (máx. 3)' },
  { small: 2149, big: 2155, smallName: 'Emerald', bigName: 'Big Emerald', bonus: '+1 skill por stack en armadura (4; demon armor 6)' },
  { small: 2150, big: 2153, smallName: 'Amethyst', bigName: 'Violet Gem', bonus: '+1 ML en wand o rod (máx. 4)' },
  { small: 2146, big: 2154, smallName: 'Sapphire', bigName: 'Yellow Gem', bonus: '+10 de velocidad en botas (máx. 3)' },
  { small: 2145, big: 2158, smallName: 'Diamond', bigName: 'Blue Gem', bonus: 'Crystal arrow: +5% velocidad por stack (máx. 5)' },
];

const IMBUE = [
  { id: 2154, name: 'Yellow Gem', item: 'Botas', effect: '+10 de velocidad por stack', max: '3' },
  { id: 2153, name: 'Violet Gem', item: 'Wand / rod', effect: '+1 ML por stack (daño de wand)', max: '4' },
  { id: 2156, name: 'Big Ruby', item: 'Arma', effect: '+5% / +9% / +16% velocidad de ataque', max: '3 (nightglass 5)' },
  { id: 2155, name: 'Big Emerald', item: 'Armadura', effect: '+1 sword, club, axe y distance por stack', max: '4 (demon 6)' },
  { id: 2158, name: 'Blue Gem', item: 'Crystal arrow', effect: '+5% velocidad de ataque por stack', max: '5' },
];

// Precios de Parived (data/npc/scripts/parived.lua).
const SELL = [
  ['Amethyst', '200'], ['Emerald, ruby, sapphire', '250'], ['Diamond', '300'],
  ['Yellow Gem', '1.000'], ['Violet Gem', '4.000'], ['Big Ruby, Big Emerald, Blue Gem', '5.000'],
  ['Talon', '300'], ['Scarab coin', '100'], ['Gold nugget', '10.000'],
];

const tiers = drops.tiers as { id: string; label: string; mult: string }[];
---
<Base title="Gemas — Retro76" path="/gemas" description="Gemas en Retro76: quién las suelta, cómo cambiarlas con Tonka, imbuir equipo y venderlas.">
  <section>
    <h1 class="title">Gemas</h1>
    <p class="lede">Las gemas salen del botín de monstruos fuertes. Juntas 20 chicas, las cambias por una grande y la usas en tu equipo para una bonificación permanente.</p>
  </section>

  <section>
    <h2 class="label">1 · Botín <span class="aside">criaturas Angry, Furious y Enraged</span></h2>
    <p class="muted">Furious y Enraged sueltan gemas chicas más seguido (×2,4 y ×3,2). Busca una criatura o abre cada gema:</p>
    <div class="field" style="max-width:22rem;margin:.75rem 0">
      <input type="search" id="mob-filter" placeholder="Buscar criatura (hydra, orc…)" autocomplete="off" aria-label="Buscar criatura">
    </div>
    <div id="drops">
      {drops.gems.map((gem: any) => {
        const g = img(gem.id);
        return (
          <details class="fold">
            <summary>
              <img class="sprite" src={g.src} srcset={g.srcset} alt="" width="32" height="32" loading="lazy">
              <span><strong>{gem.short}</strong> <span class="muted small">{gem.use}</span></span>
            </summary>
            <div class="fold-body">
              {tiers.map((t) => {
                const list: string[] = gem.monsters[t.id] || [];
                return list.length > 0 && (
                  <div class="tier-block">
                    <p class={`tier ${t.id}`}>{t.label} <span class="faint">{t.mult} · {list.length}</span></p>
                    <p class="mobs">{list.map((m) => <span data-mob={m.toLowerCase()}>{m}</span>)}</p>
                  </div>
                );
              })}
            </div>
          </details>
        );
      })}
    </div>
    <p class="empty hidden" id="no-mobs">Ninguna criatura coincide.</p>
  </section>

  <section>
    <h2 class="label">2 · Cambiar con Tonka <span class="aside">templo 140, 50 · piso 7</span></h2>
    <p class="muted">Dile <span class="mono">hi</span> y luego <span class="mono">exchange ruby</span> (o la gema que sea). Confirma con <span class="mono">si</span>.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Entregas</th><th>Recibes</th><th class="wide-only">Sirve para</th></tr></thead>
        <tbody>
          {EXCHANGE.map((x) => {
            const s = img(x.small), b = img(x.big, true);
            return (
              <tr>
                <td><span class="cell-item"><span class="mono faint">20×</span><img class="sprite" src={s.src} srcset={s.srcset} alt="" width="32" height="32" loading="lazy">{x.smallName}</span></td>
                <td><span class="cell-item"><img class="sprite lg" src={b.src} srcset={b.srcset} alt="" width="40" height="40" loading="lazy">{x.bigName}</span></td>
                <td class="muted wide-only">{x.bonus}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2 class="label">3 · Imbuir</h2>
    <p class="muted">Usa la gema grande sobre el objeto <strong>equipado</strong>. La bonificación queda en el objeto aunque lo pierdas.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Gema</th><th>En</th><th>Efecto</th><th class="n">Máx.</th></tr></thead>
        <tbody>
          {IMBUE.map((g) => {
            const b = img(g.id, true);
            return (
              <tr>
                <td><span class="cell-item"><img class="sprite lg" src={b.src} srcset={b.srcset} alt="" width="40" height="40" loading="lazy">{g.name}</span></td>
                <td>{g.item}</td>
                <td class="muted">{g.effect}</td>
                <td class="n">{g.max}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2 class="label">4 · Vender a Parived <span class="aside">mismo templo · sell ruby o sell all</span></h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Gema</th><th class="n">Oro</th></tr></thead>
        <tbody>{SELL.map(([name, gp]) => <tr><td>{name}</td><td class="n">{gp}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  // Filtro de criaturas: oculta las que no coinciden y abre las gemas con resultados.
  const input = document.getElementById('mob-filter') as HTMLInputElement;
  const folds = [...document.querySelectorAll<HTMLDetailsElement>('#drops details')];
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    for (const fold of folds) {
      let foldHits = 0;
      for (const block of fold.querySelectorAll<HTMLElement>('.tier-block')) {
        let hits = 0;
        for (const mob of block.querySelectorAll<HTMLElement>('[data-mob]')) {
          const hit = !q || (mob.dataset.mob || '').includes(q);
          mob.classList.toggle('hidden', !hit);
          if (hit) hits++;
        }
        block.classList.toggle('hidden', !hits);
        foldHits += hits;
      }
      fold.classList.toggle('hidden', !foldHits);
      fold.open = !!q && foldHits > 0;
      if (foldHits) any = true;
    }
    document.getElementById('no-mobs')!.classList.toggle('hidden', any);
  });
</script>
