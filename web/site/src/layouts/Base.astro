---
// Estructura común: <head> con SEO (y versiones por idioma), cabecera con el estado del server,
// navegación, contenido y el footer en pixel art de Chillán.
import '../styles/site.css';
import { dict, localePath } from '../i18n.js';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description?: string;
  path: string;           // ruta sin idioma ('/', '/top'...): marca el link actual y arma el cambio de idioma
  canonical?: boolean;
  langSwitch?: boolean;  // false: página solo en español (wiki), sin botón de idioma ni hreflang
  footer?: boolean;      // false: sin la escena de Chillán al final (wiki)
}

const { lang, title, path, canonical = true, langSwitch = true, footer = true } = Astro.props;
const T = dict(lang);
const description = Astro.props.description || T.description;
const other = lang === 'en' ? 'es' : 'en';
const site = 'https://retro76.cl';
const url = (l: string) => site + (localePath(l, path) === '/' ? '/' : localePath(l, path));

const NAV_GAME = ['/', '/top', '/power', '/pk', '/muertes', '/gemas', '/spells', '/reglas', '/info', '/wiki'];
const NAV_PLAY = ['/cuenta', '/cliente', '/premium', '/bugs'];
// La wiki existe solo en español: desde /en también lleva a /wiki.
const navLink = (p: string) => ({ href: p === '/wiki' ? p : localePath(lang, p), label: T.nav[p as keyof typeof T.nav], current: p === path || (p !== '/' && path.startsWith(p + '/')) });
---
<!doctype html>
<html lang={T.htmlLang === 'en' ? 'en' : T.htmlLang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0d0d0c">
  <title>{title}</title>
  <meta name="description" content={description}>
  {canonical && <link rel="canonical" href={url(lang)}>}
  {canonical && langSwitch && <link rel="alternate" hreflang="es" href={url('es')}>}
  {canonical && langSwitch && <link rel="alternate" hreflang="en" href={url('en')}>}
  {canonical && langSwitch && <link rel="alternate" hreflang="x-default" href={url('es')}>}
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/brand/favicon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Retro76">
  <meta property="og:locale" content={T.ogLocale}>
  <meta property="og:url" content={url(lang)}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://retro76.cl/assets/brand/favicon.png">
  <meta name="twitter:card" content="summary">
  <slot name="head" />
</head>
<body>
  <div class="wrap">
    <header class="site-head">
      <a class="brand" href={localePath(lang, '/')}>
        <img src="/assets/brand/favicon.png" alt="" width="24" height="24">
        Retro76 <small>{T.tagline}</small>
      </a>
      <div class="head-right">
        <p class="status" id="status" aria-live="polite"><span class="dot"></span><span id="status-text">…</span></p>
        {langSwitch && <a class="lang-switch" href={localePath(other, path)} hreflang={other} lang={other} title={T.switchTitle}>{T.switchLabel}</a>}
      </div>
    </header>
    <nav class="site-nav" aria-label={T.navLabel}>
      <ul>
        {NAV_GAME.map(navLink).map((n) => <li><a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>)}
        <li class="sep" aria-hidden="true"></li>
        {NAV_PLAY.map(navLink).map((n) => <li><a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <main>
      <slot />
    </main>
  </div>

  {footer && (
    <Fragment>
    <footer class="chillan-scene" id="scene" role="img" aria-label={T.sceneLabel}>
      <img class="still-day" src="/assets/footer/chillan-day.png" alt="" width="415" height="137" loading="lazy">
      <img class="still-night" src="/assets/footer/chillan-night.png" alt="" width="415" height="137" loading="lazy">
      <canvas width="415" height="137" aria-hidden="true"></canvas>
      <canvas width="415" height="137" aria-hidden="true"></canvas>
      <canvas width="415" height="137" aria-hidden="true"></canvas>
      <canvas width="415" height="137" aria-hidden="true"></canvas>
    </footer>
    <script is:inline src="/assets/footer/chillan-footer.js" defer></script>
    </Fragment>
  )}
  <script type="application/json" id="i18n" set:html={JSON.stringify(T.js)} />

  <script>
    import { getData, t } from '../lib/client.js';
    const dot = document.querySelector('#status .dot');
    const text = document.getElementById('status-text');
    getData().then((d) => {
      const s = d.server || {};
      dot.classList.add(s.online ? 'on' : 'off');
      text.textContent = s.online ? t('online', { n: s.players_online }) : t('offline');
    }).catch(() => { text.textContent = t('noConnection'); });
  </script>
</body>
</html>
